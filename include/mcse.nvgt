/* mcse.nvgt - MCSE, the Music Crossfade Switching Engine
 *
 * Layered adaptive music for NVGT. A piece of music is a set of layers --
 * bass, strings, brass, percussion -- each of which has several alternative
 * recordings of the same loop. Your game pushes a single number at it, the
 * intensity, and each layer crossfades to the recording that belongs at that
 * intensity. Nothing in the music has to be composed as a transition: the
 * recordings are all the same length and bar-aligned, so a crossfade between
 * two of them at the same play position is always in time.
 *
 * This is an independent implementation. It reads a theme format that an
 * existing commercial tool also writes, and it shares no code with any such
 * tool -- see docs/provenance.md.
 *
 * Distributed under the zlib licence, as NVGT's own includes are:
 * This software is provided "as-is", without any express or implied warranty.
 * In no event will the authors be held liable for any damages arising from the
 * use of this software. Permission is granted to anyone to use this software
 * for any purpose, including commercial applications, and to alter it and
 * redistribute it freely, subject to the following restrictions:
 * 1. The origin of this software must not be misrepresented; you must not
 *    claim that you wrote the original software. If you use this software in a
 *    product, an acknowledgment in the product documentation would be
 *    appreciated but is not required.
 * 2. Altered source versions must be plainly marked as such, and must not be
 *    misrepresented as being the original software.
 * 3. This notice may not be removed or altered from any source distribution.
*/

// A game that keeps its audio in a pack supplies its own loader, exactly as
// NVGT's own music.nvgt does, so MCSE never needs to know where sound comes
// from.
funcdef sound@ mcse_load_sound(sound@, string);

/** Decibels to linear gain.
 *
 * MCSE does every volume change through `set_timed_fade_in_frames`, and that
 * takes **linear** gain -- it hands its arguments straight to the audio engine
 * with no conversion, where `sound.volume` converts from decibels when the
 * engine is configured for them. Mixing the two silently produces silence: a
 * fade ending at "0 dB" is a fade ending at linear zero. So layer volumes are
 * written in decibels, as a composer expects, and converted here at the one
 * point they reach the engine. */
float mcse_gain(float db) {
	if (db <= -100) return 0;
	return pow(10.0, db / 20.0);
}

/** How a layer behaves. A loop plays continuously and crossfades between its
 * recordings; a stinger is fired once, over the top. */
enum mcse_layer_kind {
	mcse_loop = 0,
	mcse_stinger = 1,
}

/** A declared length below this is a marker rather than a measurement, so the
 * take is a placeholder: see `mcse_variation::dummy`. Real takes declare
 * lengths in the millions; the ones observed in the wild declare exactly 2. */
const int64 MCSE_DUMMY_LENGTH = 1000;

/** One recording of one layer: which intensity it belongs at, which musical
 * key it is in, and where the audio is. */
class mcse_variation {
	int intensity;     // the "trigger" in an Elias-authored theme
	int key;
	string filename;
	int64 length;      // as the theme declares it; informational

	/** A placeholder, meaning **this layer is silent at this intensity**.
	 *
	 * Not an error and not a missing file: it is a deliberate hole in the
	 * arrangement. One real theme's wind layer has takes at intensities 1, 2,
	 * 7, 10 and 11 where 7 is a placeholder -- the winds drop out in the
	 * middle of the range and come back above it.
	 *
	 * The format marks them by declaring a nonsense length: every real take
	 * declares millions and a placeholder declares 2. The audio that ships
	 * alongside is a two or three second stub, which is why a layer that
	 * looped it would be obviously wrong, and why reading this marker matters
	 * rather than trusting the file. */
	bool dummy = false;

	mcse_variation(int intensity, int key, string filename, int64 length) {
		this.intensity = intensity;
		this.key = key;
		this.filename = filename;
		this.length = length;
		this.dummy = length > 0 and length < MCSE_DUMMY_LENGTH;
	}
}

/** One layer of the music, and whichever of its recordings is playing. */
class mcse_layer {
	int id;
	string name;
	mcse_layer_kind kind = mcse_loop;
	float volume = 0;                  // dB, 0 = as recorded
	int crossfade_min = 50, crossfade_max = 250;
	int fade_in_min = 50, fade_in_max = 1000;
	int fade_out_min = 500, fade_out_max = 10000;
	int agility = 4;                   // in beats; 0 means switch immediately
	bool agility_strict = false;
	int[] agility_points;              // beat numbers, if given instead
	int pickup_beats = 0;
	// reverb, as a theme gives it: 0 to 100 each. A negative mix means the
	// theme asked for none, which is different from asking for zero.
	float reverb_mix = -1;
	float reverb_damping = 50;
	float reverb_size = 50;
	mcse_variation@[] variations;

	// runtime
	sound@ playing = null;
	sound@ leaving = null;
	mcse_variation@ current = null;
	audio_freeverb_node@ verb = null;

	bool get_wants_reverb() property { return reverb_mix >= 0; }

	/** The recording this layer should be playing at a given key and
	 * intensity.
	 *
	 * **This rule is ours and is deliberately simple**: the highest intensity
	 * at or below the one asked for, falling back to the lowest the layer has.
	 * A theme authored for another engine may have been designed against a
	 * different rule -- MCSE does not try to guess one, it documents this one
	 * so a composer can author against it. */
	mcse_variation@ choose(int key, int intensity) {
		mcse_variation@ best = null;
		mcse_variation@ lowest = null;
		for (uint i = 0; i < variations.length(); i++) {
			mcse_variation@ v = variations[i];
			if (v.key != key) continue;
			if (@lowest == null or v.intensity < lowest.intensity) @lowest = v;
			if (v.intensity <= intensity and
				(@best == null or v.intensity > best.intensity)) @best = v;
		}
		return @best != null ? best : lowest;
	}

	/** The span of intensities this layer covers, used to decide how long a
	 * crossfade should be: a one-step nudge and a leap across the whole range
	 * should not sound the same. */
	int lowest_intensity() {
		int low = -1;
		for (uint i = 0; i < variations.length(); i++)
			if (low < 0 or variations[i].intensity < low) low = variations[i].intensity;
		return low < 0 ? 0 : low;
	}
	int highest_intensity() {
		int high = 0;
		for (uint i = 0; i < variations.length(); i++)
			if (variations[i].intensity > high) high = variations[i].intensity;
		return high;
	}

	/** How long a crossfade from one recording to another should take.
	 *
	 * The theme gives a minimum and a maximum; MCSE scales between them by
	 * how far the music is being asked to move. A theme that wants a fixed
	 * length sets both to the same number. */
	int crossfade_for(int from_intensity, int to_intensity) {
		int span = highest_intensity() - lowest_intensity();
		int jump = to_intensity - from_intensity;
		if (jump < 0) jump = -jump;
		if (span <= 0 or jump >= span) return crossfade_max;
		return crossfade_min +
			int(double(crossfade_max - crossfade_min) * double(jump) / double(span));
	}

	/** Every key this layer has recordings for. */
	int[] keys() {
		int[] found;
		for (uint i = 0; i < variations.length(); i++) {
			bool seen = false;
			for (uint j = 0; j < found.length(); j++)
				if (found[j] == variations[i].key) seen = true;
			if (!seen) found.insert_last(variations[i].key);
		}
		return found;
	}
}

/** A whole piece of music: its tempo and metre, and its layers. */
class mcse_theme {
	int tempo = 120;
	int beats_per_bar = 4;
	int beat_unit = 4;
	int bars = 32;
	int sample_rate = 44100;
	int channels = 2;
	float volume = 0;
	string mode;
	mcse_layer@[] layers;
	string error;

	double ms_per_beat() const {
		// a beat is the unit the metre names, so 6/8 counts eighth notes
		return 60000.0 / double(tempo) * (4.0 / double(beat_unit));
	}
	double ms_per_bar() const { return ms_per_beat() * double(beats_per_bar); }
	uint64 frames_per_beat() const {
		return uint64(ms_per_beat() * double(sample_rate) / 1000.0);
	}

	/** How long the loop is: `bars` bars of the declared metre.
	 *
	 * **This is not the length of the audio files, and that distinction is
	 * the one that matters most here.** A recording of a 32-bar loop is
	 * longer than 32 bars, because it carries a release tail -- the reverb
	 * and the instruments dying away past the loop point. In a real theme the
	 * loop is 85.3 seconds and the files run 90.7 to 96 seconds, each as long
	 * as its own tail needs.
	 *
	 * So a layer must loop HERE and not at the end of its file. Looping at
	 * the end of the file means every layer loops at a different moment and
	 * they drift apart after one pass -- which sounds perfect for the first
	 * minute and a half and then falls apart. */
	double loop_ms() const { return ms_per_bar() * double(bars); }

	/** The loop length in frames **at a stated rate**, because there are two
	 * frame units in play and mixing them is an 8.8% error that sounds almost
	 * right.
	 *
	 * A `sound`'s frames -- position_in_frames, length_in_frames, seek, the
	 * timed fades and the engine clock -- are all in the ENGINE's output rate,
	 * which is the audio device's and need not be the file's. An
	 * `audio_data_source`'s frames are in the FILE's rate. On this machine
	 * that is 48000 against 44100: a 44.1 kHz file of 3,998,400 frames
	 * reports 4,352,000 as a sound, exactly 48000/44100 of it.
	 *
	 * So ask for the rate you mean. */
	uint64 loop_frames_at(uint rate) const {
		return uint64(loop_ms() * double(rate) / 1000.0);
	}

	/** The highest intensity any layer has a recording for -- what a game
	 * should treat as "as loud as this piece gets". */
	int max_intensity() const {
		int top = 0;
		for (uint i = 0; i < layers.length(); i++)
			for (uint j = 0; j < layers[i].variations.length(); j++)
				if (layers[i].variations[j].intensity > top)
					top = layers[i].variations[j].intensity;
		return top;
	}
}

/** Plays a theme, and moves it between intensities.
 *
 * Call loop() once per frame from your game loop, the way NVGT's own music
 * system wants its loop() called. */
class mcse_player {
	mcse_theme@ theme = null;
	mcse_load_sound@ loader = null;
	string base;                 // prefixed to every recording's filename
	mixer@ output = null;
	int intensity = 1;
	int key = 0;
	bool beat_aligned = true;    // wait for the next agility point to switch
	bool use_reverb = true;      // honour the reverb a theme asks for
	float volume = 0;
	/** Recordings that would not load. Empty is the healthy answer. */
	string[] problems;

	private bool started = false;
	private int pending_intensity = -1;
	private int pending_key = -1;
	private sound@[] stingers;

	mcse_player(mcse_theme@ theme, string base = "", mcse_load_sound@ loader = null) {
		@this.theme = @theme;
		this.base = base;
		@this.loader = @loader;
	}

	/** Open one recording, and say so when it cannot be opened.
	 *
	 * A layer whose audio fails to load is silent, and a silent layer in a
	 * four-layer piece is easy to miss -- the music still plays and simply
	 * has no bass. So failures are collected rather than swallowed. */
	private sound@ open(string filename) {
		sound@ s = sound();
		if (@output != null) s.set_mixer(output);
		if (@loader != null) {
			sound@ got = loader(s, base + filename);
			if (@got == null) problems.insert_last(base + filename);
			return got;
		}
		if (!s.stream(base + filename)) {
			problems.insert_last(base + filename);
			return null;
		}
		return s;
	}

	/** Make a recording loop at the theme's bar count rather than at the end
	 * of its own file, so every layer comes round at the same instant.
	 *
	 * Reported rather than silently skipped when it cannot be done: a layer
	 * looping at its own end is exactly the drift this exists to prevent, and
	 * it would not be audible for a minute and a half. */
	private void set_loop(sound@ s, string filename) {
		if (@s == null or @theme == null) return;
		audio_data_source@ src = s.datasource;
		if (@src == null) { problems.insert_last(filename + " (no data source to loop)"); return; }
		// the data source counts frames at the FILE's rate, not the engine's
		uint rate = src.sample_rate;
		if (rate == 0) rate = uint(theme.sample_rate);
		uint64 want = theme.loop_frames_at(rate);
		if (want == 0) return;
		uint64 length = src.length_frames;
		if (length > 0 and want > length) {
			problems.insert_last(filename + " is shorter than the theme's " +
				theme.bars + " bars, so it cannot complete a loop");
			return;
		}
		if (!src.set_loop_point(0, want))
			problems.insert_last(filename + " (its loop point could not be set)");
	}

	/** Build a layer's reverb once, from the settings its theme carries, and
	 * route a recording through it.
	 *
	 * The layer is sent entirely THROUGH freeverb rather than split into a
	 * send: freeverb has its own wet and dry controls, so the theme's `mix`
	 * is exactly that balance and no second summing stage is needed. */
	private void route(mcse_layer@ l, sound@ s) {
		if (!use_reverb or !l.wants_reverb or @s == null) return;
		if (@l.verb == null) {
			@l.verb = audio_freeverb_node();
			l.verb.room_size = l.reverb_size / 100.0;
			l.verb.damping = l.reverb_damping / 100.0;
			l.verb.wet = l.reverb_mix / 100.0;
			l.verb.dry = 1.0 - (l.reverb_mix / 100.0);
			if (!l.verb.attach_output_bus(0, sound_default_engine, 0)) @l.verb = null;
		}
		if (@l.verb != null) s.attach_output_bus(0, l.verb, 0);
	}

	private uint64 now() const { return sound_default_engine.time_in_frames; }

	/** Start the piece. Every layer is opened, aligned and faded up together.
	 *
	 * The alignment is done by seeking all the layers inside one audio buffer
	 * period rather than by scheduling a start time, because NVGT does not
	 * expose start-time scheduling to script -- `set_stop_time_*` is
	 * registered and `set_start_time_*` is not, although both exist in the
	 * engine. Seeking every layer in one tight pass lands them in the same
	 * buffer, which is sample-aligned in practice; with start-time scheduling
	 * it would be sample-aligned by construction. */
	bool start(int intensity = 1, int fade_ms = -1) {
		if (@theme == null) return false;
		this.intensity = intensity;
		started = false;
		problems.resize(0);
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (l.kind != mcse_loop) continue;
			@l.current = l.choose(key, intensity);
			if (@l.current == null or l.current.dummy) continue;
			@l.playing = open(l.current.filename);
			if (@l.playing == null) continue;
			l.playing.looping = true;
			set_loop(l.playing, l.current.filename);
			route(l, l.playing);
		}
		// one tight pass: start them, then put them all at frame 0 together
		for (uint i = 0; i < theme.layers.length(); i++)
			if (@theme.layers[i].playing != null) theme.layers[i].playing.play_looped();
		for (uint i = 0; i < theme.layers.length(); i++)
			if (@theme.layers[i].playing != null) theme.layers[i].playing.seek_in_frames(0);

		uint64 at = now();
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (@l.playing == null) continue;
			// a negative fade means "whatever the theme asked for", which is
			// the layer's own fade_in -- the theme carries it and there is no
			// reason for the caller to have to know it
			uint64 len = frames_for_ms(fade_ms < 0 ? l.fade_in_max : fade_ms);
			float gain = mcse_gain(l.volume + volume);
			// a zero-length fade is how an instant, unambiguously LINEAR
			// volume is set; the `volume` property's units depend on how the
			// engine was configured, and these fades' never do
			l.playing.set_timed_fade_in_frames(len == 0 ? gain : 0, gain, len, at);
		}
		started = true;
		return true;
	}

	/** The engine's output rate, which is the audio device's and need not be
	 * the theme's. Every sound-side frame count is in this. */
	uint get_engine_rate() property {
		int rate = sound_default_engine.sample_rate;
		return rate > 0 ? uint(rate) : 48000;
	}

	uint64 frames_for_ms(int ms) const {
		return uint64(double(ms) * double(sound_default_engine.sample_rate) / 1000.0);
	}

	/** Ask for a different intensity. Takes effect at the next agility point
	 * unless beat_aligned is false. */
	void set_intensity(int value) {
		if (value == intensity and pending_intensity < 0) return;
		pending_intensity = value;
		if (!beat_aligned) apply_pending();
	}

	void set_key(int value) {
		pending_key = value;
		if (!beat_aligned) apply_pending();
	}

	/** How far through the current bar we are, in beats. */
	double beat_position() {
		mcse_layer@ anchor = reference_layer();
		if (@anchor == null or @anchor.playing == null) return 0;
		double ms = double(anchor.playing.position_in_frames) * 1000.0
			/ double(sound_default_engine.sample_rate);
		return ms / theme.ms_per_beat();
	}

	private mcse_layer@ reference_layer() {
		for (uint i = 0; i < theme.layers.length(); i++)
			if (@theme.layers[i].playing != null and theme.layers[i].playing.playing)
				return theme.layers[i];
		return null;
	}

	/** Whether we are close enough to an agility point to switch now. */
	private bool at_switch_point(mcse_layer@ l) {
		if (!beat_aligned or l.agility <= 0) return true;
		double beats = beat_position();
		if (l.agility_points.length() > 0) {
			for (uint i = 0; i < l.agility_points.length(); i++) {
				double d = beats - double(l.agility_points[i]);
				if (d >= 0 and d < 0.25) return true;
			}
			return false;
		}
		double into = beats - double(int(beats / double(l.agility)) * l.agility);
		return into < 0.25;
	}

	private void apply_pending() {
		if (pending_key >= 0) { key = pending_key; pending_key = -1; }
		if (pending_intensity >= 0) { intensity = pending_intensity; pending_intensity = -1; }
		for (uint i = 0; i < theme.layers.length(); i++)
			switch_layer(theme.layers[i]);
	}

	/** Crossfade one layer to whatever it should be playing now.
	 *
	 * The new recording is opened, put at the same play position as the one
	 * leaving, and both fades are scheduled at the same absolute frame -- so
	 * the two sides of the crossfade are welded together whatever the frame
	 * rate of the game loop. */
	private void switch_layer(mcse_layer@ l) {
		if (l.kind != mcse_loop) return;
		mcse_variation@ want = l.choose(key, intensity);
		if (@want == null or (@l.current != null and want is l.current)) return;

		// a placeholder means this layer is silent here: fade it out and let
		// it go, rather than looping a two-second stub
		if (want.dummy) {
			if (@l.playing != null) {
				uint64 out_at = now();
				uint64 out_len = frames_for_ms(l.fade_out_min);
				l.playing.set_timed_fade_in_frames(
					mcse_gain(l.volume + volume), 0, out_len, out_at);
				l.playing.set_stop_time_with_fade_in_frames(out_at + out_len, 0);
				@l.leaving = @l.playing;
				@l.playing = null;
			}
			@l.current = @want;
			return;
		}

		// ...and a layer that was silent has to be STARTED rather than
		// crossfaded, in step with whatever is already playing
		if (@l.playing == null) {
			sound@ back = open(want.filename);
			if (@back == null) return;
			back.looping = true;
			set_loop(back, want.filename);
			route(l, back);
			back.play_looped();
			mcse_layer@ anchor = reference_layer();
			if (@anchor != null and @anchor.playing != null)
				back.seek_in_frames(anchor.playing.position_in_frames);
			uint64 in_at = now();
			back.set_timed_fade_in_frames(
				0, mcse_gain(l.volume + volume), frames_for_ms(l.fade_in_max), in_at);
			@l.playing = @back;
			@l.current = @want;
			return;
		}

		uint64 at = now() + frames_for_ms(20);     // a hair ahead of the clock
		uint64 len = frames_for_ms(l.crossfade_for(
			@l.current != null ? l.current.intensity : want.intensity, want.intensity));
		uint64 pos = l.playing.position_in_frames;

		sound@ next = open(want.filename);
		if (@next == null) return;
		next.looping = true;
		set_loop(next, want.filename);
		route(l, next);
		next.play_looped();
		float gain = mcse_gain(l.volume + volume);
		// where the leaving layer will be when the crossfade begins
		next.seek_in_frames(pos + (at > now() ? at - now() : 0));
		next.set_timed_fade_in_frames(0, gain, len, at);

		l.playing.set_timed_fade_in_frames(gain, 0, len, at);
		l.playing.set_stop_time_with_fade_in_frames(at + len, 0);
		@l.leaving = @l.playing;
		@l.playing = @next;
		@l.current = @want;
	}

	/** Fire a stinger -- a one-shot flourish over the top of the loops. */
	bool play_stinger(int layer_id = -1) {
		if (@theme == null) return false;
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (l.kind != mcse_stinger) continue;
			if (layer_id >= 0 and l.id != layer_id) continue;
			mcse_variation@ v = l.choose(key, intensity);
			if (@v == null) continue;
			sound@ s = open(v.filename);
			if (@s == null) continue;
			route(l, s);
			float gain = mcse_gain(l.volume + volume);
			s.set_timed_fade_in_frames(gain, gain, 0, now());
			s.play();
			stingers.insert_last(@s);
			if (layer_id >= 0) return true;
		}
		return true;
	}

	/** Call once per frame. */
	void loop() {
		if (!started or @theme == null) return;
		if (pending_intensity >= 0 or pending_key >= 0) {
			mcse_layer@ anchor = reference_layer();
			if (@anchor == null or at_switch_point(anchor)) apply_pending();
		}
		// let go of anything that has finished
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (@l.leaving != null and !l.leaving.playing) @l.leaving = null;
		}
		for (uint i = 0; i < stingers.length();) {
			if (!stingers[i].playing) stingers.remove_at(i);
			else i++;
		}
	}

	void stop(int fade_ms = 500) {
		uint64 at = now();
		uint64 len = frames_for_ms(fade_ms);
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (@l.playing == null) continue;
			l.playing.set_timed_fade_in_frames(mcse_gain(l.volume + volume), 0, len, at);
			l.playing.set_stop_time_with_fade_in_frames(at + len, 0);
		}
		started = false;
	}

	void set_volume(float db) property {
		volume = db;
		uint64 at = now();
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (@l.playing == null) continue;
			float gain = mcse_gain(l.volume + volume);
			l.playing.set_timed_fade_in_frames(gain, gain, 0, at);
		}
	}
	float get_volume() const property { return volume; }

	/** Move this whole piece to a new master level over a time, keeping each
	 * layer's own relative level. This is how one piece is crossfaded against
	 * another; within a piece, use set_intensity. */
	void fade_master(float db, int ms) {
		uint64 at = now();
		uint64 len = frames_for_ms(ms);
		for (uint i = 0; i < theme.layers.length(); i++) {
			mcse_layer@ l = theme.layers[i];
			if (@l.playing == null) continue;
			l.playing.set_timed_fade_in_frames(
				mcse_gain(l.volume + volume), mcse_gain(l.volume + db), len, at);
		}
		volume = db;
	}

	/** Whether anything is still making a sound. */
	bool get_sounding() property {
		for (uint i = 0; i < theme.layers.length(); i++)
			if (@theme.layers[i].playing != null and theme.layers[i].playing.playing)
				return true;
		return false;
	}
}

/** Plays one piece at a time, and crossfades between pieces.
 *
 * Switching between two pieces is a different job from moving around inside
 * one. Inside a piece every layer shares a grid, so a switch happens at the
 * same play position and stays in time. Two different pieces share no grid at
 * all -- different tempo, different length, different key -- so there is
 * nothing to align and the honest thing is to fade one out while the other
 * comes in. What can still be done is to wait for the outgoing piece to reach
 * a bar line before starting, which is what `on_bar` is for and is the
 * difference between a change of music and an interruption. */
class mcse_manager {
	mcse_player@ current = null;
	mcse_player@ outgoing = null;
	float volume = 0;
	bool on_bar = true;          // wait for a bar line before crossfading

	private mcse_player@ waiting = null;
	private int waiting_fade = 0;

	/** Crossfade to a piece. The first call simply starts it. */
	void play(mcse_theme@ theme, string base, int intensity = 1,
			  int fade_ms = 1000, mcse_load_sound@ loader = null) {
		mcse_player@ next = mcse_player(theme, base, loader);
		next.volume = volume;
		if (@current == null) {
			@current = @next;
			current.start(intensity, fade_ms);
			return;
		}
		next.intensity = intensity;
		if (!on_bar) { begin(next, fade_ms); return; }
		@waiting = @next;
		waiting_fade = fade_ms;
	}

	private void begin(mcse_player@ next, int fade_ms) {
		// the piece leaving keeps playing while it fades, so the two overlap
		if (@outgoing != null) outgoing.stop(0);
		@outgoing = @current;
		@current = @next;
		current.volume = -100;
		current.start(current.intensity, fade_ms);
		current.fade_master(volume, fade_ms);
		if (@outgoing != null) {
			outgoing.fade_master(-100, fade_ms);
			outgoing.stop(fade_ms);
		}
	}

	/** Call once per frame. */
	void loop() {
		if (@current != null) current.loop();
		if (@outgoing != null) {
			outgoing.loop();
			if (!outgoing.sounding) @outgoing = null;
		}
		if (@waiting != null and @current != null) {
			double beats = current.beat_position();
			double per_bar = double(current.theme.beats_per_bar);
			double into = beats - double(int(beats / per_bar) * per_bar);
			if (into < 0.25) {
				mcse_player@ next = @waiting;
				@waiting = null;
				begin(next, waiting_fade);
			}
		}
	}

	void set_intensity(int value) { if (@current != null) current.set_intensity(value); }
	void set_key(int value) { if (@current != null) current.set_key(value); }
	bool play_stinger(int layer_id = -1) {
		return @current != null ? current.play_stinger(layer_id) : false;
	}
	void stop(int fade_ms = 500) {
		@waiting = null;
		if (@current != null) current.stop(fade_ms);
		if (@outgoing != null) outgoing.stop(fade_ms);
	}
	void set_volume(float db) property {
		volume = db;
		if (@current != null) current.volume = db;
	}
	float get_volume() const property { return volume; }
}
